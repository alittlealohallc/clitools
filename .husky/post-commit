#!/bin/sh
set -e

# [local-install] is always the repo root (git hooks run with cwd at the top
# of the working tree, and huskify.zsh only installs there - no nested
# monorepo installs), so this always targets ./package.json and ./CHANGELOG.md.

update_changelog() {
  version="$1"
  entry_date="$2"
  body="$3"
  changelog="CHANGELOG.md"
  tmp="$(mktemp)"

  {
    printf '# Changelog\n\n'
    printf '## %s - %s\n\n' "$version" "$entry_date"
    if [ -n "$body" ]; then
      printf '%s\n\n' "$body"
    fi
    if [ -f "$changelog" ]; then
      # Drop the existing "# Changelog" header (and the blank line after it,
      # if present) so it isn't duplicated; keep every prior entry as-is.
      sed -E '1{/^# Changelog[[:space:]]*$/d;}' "$changelog" | sed '1{/^$/d;}'
    fi
  } > "$tmp"

  mv "$tmp" "$changelog"
}

if [ -f .husky/.version-type ]; then
  version_type=$(cat .husky/.version-type)
  rm -f .husky/.version-type

  current_branch=$(git rev-parse --abbrev-ref HEAD)
  if [ "$current_branch" != "main" ]; then
    rm -f .husky/.commit-message
    exit 0
  fi

  echo "[post-commit] Bumping version ($version_type)"

  bump_output=$(node .husky/bump-version.cjs "$version_type" ./package.json 2>/tmp/bump-version.$$) || {
    status=$?
    if [ "$status" -eq 3 ]; then
      echo "[post-commit] Skipping (no valid semver \"version\" field in package.json)"
      rm -f /tmp/bump-version.$$ .husky/.commit-message
      exit 0
    fi
    echo "[post-commit] Warning: failed to bump package.json (exit $status)" >&2
    cat /tmp/bump-version.$$ >&2
    rm -f /tmp/bump-version.$$
    exit "$status"
  }
  rm -f /tmp/bump-version.$$
  new_version=$(printf '%s' "$bump_output" | sed 's/^v//')

  # Update CHANGELOG.md (created if missing) with the release entry
  commit_message_body=""
  if [ -f .husky/.commit-message ]; then
    commit_message_body=$(cat .husky/.commit-message)
    rm -f .husky/.commit-message
  fi
  update_changelog "$new_version" "$(date +%Y-%m-%d)" "$commit_message_body"

  git add package.json CHANGELOG.md
  [ -f package-lock.json ] && git add package-lock.json

  # If nothing changed, don't create another commit/tag
  if git diff --cached --quiet; then
    echo "[post-commit] No version changes to commit."
    exit 0
  fi

  git commit -m "chore: release $new_version" --no-verify
  git tag -a "$new_version" -m "Release $new_version"

  echo "[post-commit] Done - committed and tagged $new_version"
fi

exit 0
