#!/bin/zsh
set -e

COMMIT_MSG=$(<"$1")

VERSION_TYPE="$(
  print -r -- "$COMMIT_MSG" | sed -nE 's/.*\[(patch|minor|major)\].*/\1/p' | head -n 1
)"

if [[ -n "$VERSION_TYPE" ]]; then
  echo "[commit-msg] Detected version bump: $VERSION_TYPE"
  mkdir -p .husky
  echo "$VERSION_TYPE" > .husky/.version-type
fi

exit 0
