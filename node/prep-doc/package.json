{
  "name": "import-doc",
  "version": "1.2.0",
  "description": "Convert ODF/TXT/DOCX → MD/MDX/HTML/PDF with frontmatter & category support. Replaces create-doc.zsh.",
  "type": "module",
  "bin": {
    "import-doc": "./index.js",
    "push": "git push --follow-tags",
    "push:minor": "VERSION_TYPE=minor git push --follow-tags",
    "push:major": "VERSION_TYPE=major git push --follow-tags"
  },
  "scripts": {
    "start": "node index.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "glob": "^13.0.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
