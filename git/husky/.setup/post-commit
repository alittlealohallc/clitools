#!/bin/sh
set -e

update_changelog() {
  version="$1"
  entry_date="$2"
  body="$3"
  changelog="CHANGELOG.md"
  tmp="$(mktemp)"

  {
    printf '# Changelog\n\n'
    printf '## %s - %s\n\n' "$version" "$entry_date"
    if [ -n "$body" ]; then
      printf '%s\n\n' "$body"
    fi
    if [ -f "$changelog" ]; then
      # Drop the existing "# Changelog" header (and the blank line after it,
      # if present) so it isn't duplicated; keep every prior entry as-is.
      sed -E '1{/^# Changelog[[:space:]]*$/d}' "$changelog" | sed '1{/^$/d}'
    fi
  } > "$tmp"

  mv "$tmp" "$changelog"
}

if [ -f .husky/.version-type ]; then
  version_type=$(cat .husky/.version-type)
  rm -f .husky/.version-type

  current_branch=$(git rev-parse --abbrev-ref HEAD)
  if [ "$current_branch" != "main" ]; then
    rm -f .husky/.commit-message
    exit 0
  fi

  echo "[post-commit] Bumping versions: $version_type"

  # Find package.json files for subpackages (exclude node_modules and nested src/package.json)
  pkgs=$(find . -type f -name package.json \
    -not -path './node_modules/*' \
    -not -path './.git/*' \
    -not -path './git/*' \
    -not -path '*/src/package.json' \
    -not -path './package.json' )

  # Also bump root package.json (remove this if you truly only want subfolders)
  all_pkgs="./package.json"
  if [ -n "$pkgs" ]; then
    all_pkgs="$all_pkgs
$pkgs"
  fi

  # Bump each package.json in-place and collect which ones changed
  changed_pkgs=""
  for pkg in $all_pkgs; do
    node .husky/bump-version.cjs "$version_type" "$pkg" >/dev/null
    changed_pkgs="$changed_pkgs $pkg"
  done

  new_version=$(node -p "require('./package.json').version" )

  # Update CHANGELOG.md (created if missing) with the release entry
  commit_message_body=""
  if [ -f .husky/.commit-message ]; then
    commit_message_body=$(cat .husky/.commit-message)
    rm -f .husky/.commit-message
  fi
  update_changelog "$new_version" "$(date +%Y-%m-%d)" "$commit_message_body"
  git add CHANGELOG.md

  # Stage bumped package.json files
  git add $changed_pkgs

  # Stage any lockfiles that exist in the same directories as bumped package.json
  # (root package-lock.json will also be staged if present)
  for pkg in $changed_pkgs; do
    dir=$(dirname "$pkg")
    [ -f "$dir/package-lock.json" ] && git add "$dir/package-lock.json" || true
  done

  # If nothing changed, don't create another commit/tag
  if git diff --cached --quiet; then
    echo "[post-commit] No version changes to commit."
    exit 0
  fi

  git commit -m "chore: release $new_version" --no-verify
  git tag -a "$new_version" -m "Release $new_version"

  echo "[post-commit] Done - committed and tagged $new_version"
fi

exit 0
