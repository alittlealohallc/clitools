#!/bin/zsh
set -e

if [[ -f .husky/.version-type ]]; then
    VERSION_TYPE=$(cat .husky/.version-type)
    rm .husky/.version-type

    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$CURRENT_BRANCH" != "main" ]]; then
        echo "[post-commit] Not on main branch, skipping version bump"
        exit 0
    fi

    echo "[post-commit] Bumping version: $VERSION_TYPE"

    # Bump version via .cjs script (CommonJS extension bypasses "type":"module")
    NEW_VERSION=$(node scripts/bump-version.cjs "$VERSION_TYPE")

    # Stage package.json (and lock file if present)
    git add package.json
    [[ -f package-lock.json ]] && git add package-lock.json

    # Commit and tag without re-triggering hooks
    git commit -m "chore: release $NEW_VERSION" --no-verify
    git tag -a "$NEW_VERSION" -m "Release $NEW_VERSION"

    echo "[post-commit] Done — committed and tagged $NEW_VERSION"
fi

exit 0
