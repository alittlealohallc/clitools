#!/bin/zsh
set -e

# Check if a version bump was requested
if [[ -f .husky/.version-type ]]; then
    VERSION_TYPE=$(cat .husky/.version-type)
    rm .husky/.version-type
    
    # Only run version bump on main branch
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$CURRENT_BRANCH" != "main" ]]; then
        echo "[post-commit] Not on main branch, skipping version bump"
        exit 0
    fi
    
    echo "[post-commit] Running version bump: $VERSION_TYPE"
    
    # Use npm version to bump (works for single + monorepos)
    npm version "$VERSION_TYPE" --no-git-tag-version || true
    
    # Get the new version
    CURRENT_VERSION=$(node -p "require('./package.json').version" 2>/dev/null || echo "unknown")
    
    if [[ "$CURRENT_VERSION" != "unknown" ]]; then
        # Stage the updated package.json
        git add package.json package-lock.json 2>/dev/null || git add package.json 2>/dev/null || true
        
        # Create the tag
        git tag -a "v$CURRENT_VERSION" -m "Release v$CURRENT_VERSION" 2>/dev/null || true
        
        # Commit the version bump
        git commit --amend --no-edit 2>/dev/null || true
        
        echo "[post-commit] Created git tag: v$CURRENT_VERSION"
    fi
fi

exit 0
